# Copy to .env.local for local development; set the same names in Vercel
# (Project -> Settings -> Environment Variables) for deployment.
# NEVER commit real values. Server-only secrets must never be prefixed NEXT_PUBLIC_.

# --- AI: Gemini Flash (all AI tasks) -------------------------------------------
# Google AI Studio -> Get API key.
GEMINI_API_KEY=
# Any Gemini *Flash* model id available to your key (see docs/README "Gemini model").
GEMINI_MODEL=gemini-3.8-flash

# --- Live discovery: Tavily -----------------------------------------------------
# app.tavily.com -> API Keys (starts with tvly-)
TAVILY_API_KEY=

# --- Context: Neon PostgreSQL ---------------------------------------------------
# Neon console -> Connection details -> pooled connection string (sslmode=require)
DATABASE_URL=

# --- Output: Resend -------------------------------------------------------------
# resend.com -> API Keys
RESEND_API_KEY=
# Sender. Without a verified domain Resend only allows onboarding@resend.dev and
# only delivers to the email address of your own Resend account.
RESEND_FROM_EMAIL=Industry Event Scout <onboarding@resend.dev>

# --- Trigger / auth -------------------------------------------------------------
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". >= 16 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Password for the single-user dashboard. >= 12 chars.
ADMIN_PASSWORD=
# Signs the dashboard session cookie. >= 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Public ---------------------------------------------------------------------
# Public base URL of the deployment, e.g. https://your-app.vercel.app (no secrets here)
NEXT_PUBLIC_APP_URL=http://localhost:3000
